OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# MongoDB Atlas connection string. Put the real credentials only in local .env.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@worklaw-rag.vcgem0k.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=worklaw_rag
MONGODB_COLLECTION=documents
MONGODB_VECTOR_INDEX=vector_index
MONGODB_VECTOR_FIELD=embedding
MONGODB_TIMEOUT_MS=10000

# Source collection and chunking
DOCS_SITEMAP_URL=https://docs.python.org/sitemap.xml
MAX_PAGES=100
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
REQUEST_TIMEOUT=20
